{
  "info": {
    "name": "Shoplens API",
    "description": "Postman collection for the Shoplens API.\n\n1. Import this file and `shoplens.postman_environment.json`, then select the \"Shoplens - Local\" environment.\n2. Run **Auth > Login (demo account)**. It saves `accessToken` for every other request.\n3. Run **Chat > Send message (new conversation)**, then **Send message (continue conversation)**. The conversation id is saved automatically.\n\nThe same API is documented interactively at `{{baseUrl}}/docs` (Swagger UI).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "conversationId",
      "value": ""
    },
    {
      "key": "email",
      "value": "demo@shoplens.in"
    },
    {
      "key": "password",
      "value": "Demo@1234"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup (new account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('returns an access token and the user', () => {",
                  "  pm.expect(json.accessToken).to.be.a('string');",
                  "  pm.expect(json.user.email).to.be.a('string');",
                  "});",
                  "// Subsequent requests now run as the new user.",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('email', json.user.email);",
                  "pm.collectionVariables.set('password', 'Passw0rd!x');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"user-{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd!x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Creates an account, seeds four sample orders, returns an access token and sets the refresh cookie. 409 if the email already exists. Rate limited: 10 requests per 15 minutes per IP."
          }
        },
        {
          "name": "Login (demo account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(json.accessToken).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', json.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Defaults to the seeded demo account (demo@shoplens.in / Demo@1234). Saves the access token for the rest of the collection. A wrong password or unknown email both return 401 \"Invalid email or password\"."
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Uses the httpOnly `refresh_token` cookie that Postman stored at login (no body needed). Rotates the cookie. Replaying an old refresh token revokes the session."
          }
        },
        {
          "name": "Current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the user', () => pm.expect(pm.response.json().user.email).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('accessToken', '');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the session and clears the refresh cookie."
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send message (new conversation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// One fresh key per send. Re-sending the SAME key never duplicates the message or the model call.",
                  "pm.variables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (event stream)', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "const text = pm.response.text();",
                  "pm.test('stream ends with a done event', () => pm.expect(text).to.include('event: done'));",
                  "const meta = /event: meta\\ndata: (.+)/.exec(text);",
                  "if (meta) pm.collectionVariables.set('conversationId', JSON.parse(meta[1]).conversationId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What's your return policy?\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "send"
              ]
            },
            "description": "Starts a conversation and streams the reply as Server-Sent Events: `meta`, `tool`, `token`..., `sources`, `done` (plus `usage` in development mode). Postman shows the raw event text. Saves `conversationId` for the next requests."
          }
        },
        {
          "name": "Send message (continue conversation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK (event stream)', () => pm.response.to.have.status(200));",
                  "pm.test('stream ends with a done event', () => pm.expect(pm.response.text()).to.include('event: done'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"message\": \"Where is my order SE1041?\",\n  \"idempotencyKey\": \"{{idempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "send"
              ]
            },
            "description": "Adds a message to the conversation saved by the previous request. Only the new message is sent: the server rebuilds the recent history itself. 404 if the conversation id is not yours."
          }
        },
        {
          "name": "List conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has conversations and a cursor field', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.conversations).to.be.an('array');",
                  "  pm.expect(json).to.have.property('nextCursor');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/history?limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "history"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1 to 50"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "description": "nextCursor from the previous page",
                  "disabled": true
                }
              ]
            },
            "description": "Your conversations, newest first. Pass `nextCursor` as `cursor` for the next page."
          }
        },
        {
          "name": "Get conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has messages', () => pm.expect(pm.response.json().messages).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/history/:conversationId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "history",
                ":conversationId"
              ],
              "variable": [
                {
                  "key": "conversationId",
                  "value": "{{conversationId}}"
                }
              ]
            },
            "description": "All messages of one conversation. Someone else's conversation looks the same as a missing one (404)."
          }
        },
        {
          "name": "Delete conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('conversationId', '');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/history/:conversationId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "history",
                ":conversationId"
              ],
              "variable": [
                {
                  "key": "conversationId",
                  "value": "{{conversationId}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns the catalog', () => pm.expect(pm.response.json().products).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "description": "The demo product catalog. The home page and the assistant's product answers use the same data."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('returns an orders array', () => pm.expect(pm.response.json().orders).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "description": "Your ten most recent orders, newest first. Read-only: to cancel or return an order, ask the assistant in a Chat request."
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('database is up', () => pm.expect(pm.response.json().db).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    }
  ]
}

NODE_ENV=development
PORT=4000

# MongoDB (the connection string is assembled at boot)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=shoplens
# Leave user/password empty for the local atlas-local container (no auth)
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# Atlas: MONGO_SRV=true, MONGO_HOST=<cluster>.mongodb.net, MONGO_OPTIONS=retryWrites=true&w=majority
MONGO_SRV=false
# The local atlas-local image needs a direct connection
MONGO_OPTIONS=directConnection=true

# Two different random secrets, 32+ chars each:  openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

OPENROUTER_API_KEY=
# Comma-separated: first is the primary model, the rest are fallbacks
LLM_MODELS=openai/gpt-oss-20b:free,meta-llama/llama-3.3-70b-instruct:free
# Reserved for RAG (not used yet)
EMBEDDING_MODEL=openai/text-embedding-3-small
# openrouter | mock  (mock = scripted replies, no API key needed)
LLM_PROVIDER=openrouter

CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of Express (Vercel + Render = 2 in production)
TRUST_PROXY=0

# Optional
# Secure refresh cookie. Defaults to true in production; false for plain-http hosting
# COOKIE_SECURE=false
# bcrypt cost factor (default 12)
# BCRYPT_COST=12
# Path to the built client, served by Express (set automatically in Docker)
# CLIENT_DIST=../client/dist

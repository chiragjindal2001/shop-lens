# ---------- Server ----------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0
# COOKIE_SECURE=false          # only for plain-http hosting; defaults to true in production
# API_DOCS=true                # Swagger UI at /api/docs; on in dev, off in production by default
# BCRYPT_COST=12

# ---------- MongoDB Atlas ----------
MONGO_SRV=true
MONGO_HOST=<your-cluster>.mongodb.net
# MONGO_PORT=                  # leave out for Atlas
MONGO_DB_NAME=shoplens
MONGO_USER=<database-user>
MONGO_PASSWORD=<database-password>
MONGO_AUTH_SOURCE=admin
MONGO_OPTIONS=retryWrites=true&w=majority

# ---------- Auth ----------
# Two different random strings, 32+ chars each:  openssl rand -base64 48
JWT_ACCESS_SECRET=<random-32+-chars>
JWT_REFRESH_SECRET=<different-random-32+-chars>
ACCESS_TOKEN_TTL=15m           # 1m to 1d
REFRESH_TOKEN_TTL=7d           # up to 90d; each use renews it

# ---------- LLM (OpenRouter) ----------
LLM_PROVIDER=openrouter        # or "mock" for scripted replies without a key
OPENROUTER_API_KEY=<your-openrouter-key>
LLM_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30s
LLM_MAX_RETRIES=2

# ---------- RAG ----------
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
KB_MIN_SCORE=0.40
# KB_DIR=./kb

# ---------- Limits ----------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW=1m
HISTORY_MAX_MESSAGES=10
HISTORY_MAX_CHARS=12000
MAX_TOOL_ROUNDS=4
